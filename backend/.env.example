# 服务端口
PORT=3000

# MySQL 连接（本机 chuxin 库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chuxin
DB_PASSWORD=chuxin123
DB_NAME=chuxin

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-random-string

# 微信小程序（appid 取自 project.config.json）
WX_APPID=wx89665ba93475af78
# 微信 secret：留空时自动启用 mock 登录（用 code 模拟 openid，方便本地联调）
# 去微信公众平台「开发管理-开发设置」拿到后填在这里，即切换为真实登录
WX_SECRET=

# AI 分析 worker 回调密钥（默认与 worker.py 内置值一致；改的话两边要同步）
ANALYSIS_WORKER_KEY=chuxin-worker-dev-key

# 可选：视频上传大小上限(MB)，默认 200
# UPLOAD_MAX_MB=50