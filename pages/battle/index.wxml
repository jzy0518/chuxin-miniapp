<!--pages/battle/index.wxml-->
<view class="page">
  <view class="page__header">实战</view>

  <!-- 相册上传视频 -->
  <view class="upload card" bindtap="chooseVideo">
    <block wx:if="{{status === 'idle'}}">
      <view class="upload__icon i-upload"></view>
      <view class="upload__title">从相册上传视频</view>
      <view class="upload__tip">点击选择一段挥拍视频</view>
    </block>

    <block wx:elif="{{status === 'uploading'}}">
      <view class="upload__icon i-upload"></view>
      <view class="upload__title">正在上传 {{progress}}%</view>
      <view class="progress"><view class="progress__inner" style="width: {{progress}}%;"></view></view>
      <view class="upload__tip">{{videoName}}</view>
    </block>

    <block wx:else>
      <view class="upload__icon i-done"></view>
      <view class="upload__title">上传完成</view>
      <view class="upload__tip">{{videoName}}</view>
    </block>
  </view>

  <view class="hint">视频分析结果展示页将在后续版本上线</view>

  <!-- 历史视频列表 -->
  <view class="history" wx:if="{{videos.length}}">
    <view class="history__header">历史视频</view>
    <view class="video-item" wx:for="{{videos}}" wx:key="id">
      <view class="video-item__info">
        <view class="video-item__title">{{item.title}}</view>
        <view class="video-item__meta" wx:if="{{item.timeText}}">{{item.timeText}}<block wx:if="{{item.durationText}}"> · {{item.durationText}}</block></view>
      </view>
      <view class="badge badge--{{item.badgeCls}}">{{item.badgeText}}</view>
    </view>
  </view>
  <view class="history--empty" wx:else>还没有上传过视频，选一段挥拍视频试试</view>
</view>