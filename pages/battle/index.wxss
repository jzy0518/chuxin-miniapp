/*pages/battle/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 40rpx) 40rpx calc(160rpx + env(safe-area-inset-bottom));
}

.page__header {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 8rpx 0 28rpx;
}

/* ========== 上传卡片 ========== */
.upload {
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(63, 104, 255, 0.3);
  text-align: center;
}

.upload__icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.upload__title {
  font-size: 36rpx;
  font-weight: 700;
}

.upload__tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  word-break: break-all;
}

.progress {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-top: 24rpx;
  overflow: hidden;
}

.progress__inner {
  height: 100%;
  border-radius: 6rpx;
  background: #ffffff;
  transition: width 0.3s ease;
}

.hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa0a6;
}

/* ========== CSS 图标 ========== */
/* 上传箭头 */
.i-upload {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}
.i-upload::before {
  content: '';
  position: absolute;
  left: 18rpx;
  bottom: 4rpx;
  width: 36rpx;
  height: 14rpx;
  border: 6rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}
.i-upload::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 24rpx solid currentColor;
  transform: translateX(-50%);
}

/* 完成对勾 */
.i-done {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}
.i-done::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 28rpx;
  height: 16rpx;
  border-left: 8rpx solid currentColor;
  border-bottom: 8rpx solid currentColor;
  transform: rotate(-45deg);
  box-sizing: border-box;
}