/*pages/train/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 底部预留 160rpx = tabBar 高度(104rpx) + 中间凸起按钮(44rpx) + 间距 */
  padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

.page__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 8rpx 8rpx 0;
}

.page__subtitle {
  font-size: 24rpx;
  color: #9aa0a6;
  padding: 10rpx 8rpx 24rpx;
}

/* 动作分类列表 */
.list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  gap: 24rpx;
}

.list-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #eaf0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

/* 网前动作图标配色 */
.list-item__icon--net {
  background: #e6f7ee;
}

.list-item__body {
  flex: 1;
  min-width: 0;
}

.list-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.list-item__meta {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.list-item__arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #3d6bff;
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 底部主操作（页面已预留 tabBar 空间，这里只保留与列表的间距） */
.footer {
  padding: 20rpx 0 0;
}

.footer__btn {
  background: #2b4cd8;
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(43, 76, 216, 0.25);
}

.footer__tip {
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  margin-top: 16rpx;
}