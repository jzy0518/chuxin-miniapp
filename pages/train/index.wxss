/*pages/train/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx 0;
}

.page__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 8rpx 8rpx 0;
}

.page__subtitle {
  font-size: 24rpx;
  color: #9aa0a6;
  padding: 10rpx 8rpx 24rpx;
}

/* 动作分类列表 */
.list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  gap: 24rpx;
}

.list-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #eaf0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.list-item__body {
  flex: 1;
  min-width: 0;
}

.list-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.list-item__meta {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.list-item__arrow {
  font-size: 36rpx;
  color: #c6cad2;
  flex-shrink: 0;
}

/* 底部主操作 */
.footer {
  padding: 20rpx calc(24rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-bottom));
  padding-left: 24rpx;
}

.footer__btn {
  background: linear-gradient(135deg, #4a90e2, #5b7fff);
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
}

.footer__tip {
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  margin-top: 16rpx;
}