/*pages/train/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 底部预留 160rpx = tabBar 高度(104rpx) + 中间凸起按钮(44rpx) + 间距 */
  padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

.page__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  padding: 8rpx 8rpx 0;
}

.page__subtitle {
  font-size: 24rpx;
  color: #9aa0a6;
  padding: 10rpx 8rpx 24rpx;
}

/* 动作分类列表 */
.list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  gap: 24rpx;
  animation: item-pop 0.35s ease both;
}

.list-item:nth-child(2) {
  animation-delay: 0.04s;
}

.list-item:nth-child(3) {
  animation-delay: 0.08s;
}

.list-item:nth-child(4) {
  animation-delay: 0.12s;
}

.list-item:nth-child(5) {
  animation-delay: 0.16s;
}

.list-item:nth-child(6) {
  animation-delay: 0.2s;
}

/* 图标入场动画（替代 SVG 描边动画，WXSS 背景图无法逐笔绘制） */
@keyframes item-pop {
  from {
    opacity: 0;
    transform: translateY(16rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.list-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background-color: #eaf0ff;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 56rpx 56rpx;
  flex-shrink: 0;
}

/* 网前动作图标配色 */
.list-item__icon--net {
  background-color: #e6f7ee;
}

