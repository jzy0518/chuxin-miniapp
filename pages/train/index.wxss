.list-item__body {
  flex: 1;
  min-width: 0;
}

.list-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.list-item__arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #3d6bff;
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}