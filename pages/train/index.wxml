<!--pages/train/index.wxml-->
<view class="page">
  <view class="page__title">动作纠正</view>

  <!-- 动作网格清单 -->
  <view class="grid">
    <view
      wx:for="{{actions}}"
      wx:key="id"
      class="cell"
      data-id="{{item.id}}"
      bindtap="onTap"
    >
      <view class="cell__icon">{{item.icon}}</view>
      <view class="cell__name">{{item.name}}</view>
      <view class="cell__progress" wx:if="{{item.doneCount !== undefined}}">已纠正 {{item.doneCount}} · 待纠正 {{item.todoCount}}</view>
    </view>
  </view>
</view>