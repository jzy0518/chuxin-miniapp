/*pages/correct/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 24rpx) 24rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* 返回头（复用动作页风格） */
.nav {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
  color: #1f2329;
}

.nav__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* 统计卡 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.stats {
  display: flex;
  gap: 20rpx;
}

.stats__item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f6f7fb;
}

.stats__num {
  font-size: 44rpx;
  font-weight: 700;
  color: #3d6bff;
}

.stats__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 纠正点列表 */
.list__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.list__empty {
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.point {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.point:last-child {
  border-bottom: none;
}

.point__check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c8cdd4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
}

.point--done .point__check {
  background: #3d6bff;
  border-color: #3d6bff;
}

.point__body {
  flex: 1;
}

.point__name {
  font-size: 28rpx;
  color: #1f2329;
}

.point--done .point__name {
  color: #9aa0a6;
  text-decoration: line-through;
}

.point__note {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.point__del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #c8cdd4;
  padding: 8rpx 12rpx;
}

/* 底部固定操作区 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(31, 35, 41, 0.06);
}

.footer__input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.footer__input {
  flex: 1;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: #f6f7fb;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.footer__add {
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #3d6bff;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.footer__upload {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 2rpx solid #3d6bff;
  color: #3d6bff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}