<!--pages/correct/index.wxml-->
<view class="page">
  <!-- 自定义返回头 -->
  <view class="nav">
    <view class="nav__back" bindtap="goBack">‹</view>
    <view class="nav__title">{{actionName}} · 纠正点</view>
    <view class="nav__spacer"></view>
  </view>

  <!-- 统计卡 -->
  <view class="card stats">
    <view class="stats__item">
      <view class="stats__num">{{doneCount}}</view>
      <view class="stats__label">已纠正</view>
    </view>
    <view class="stats__item">
      <view class="stats__num">{{todoCount}}</view>
      <view class="stats__label">待纠正</view>
    </view>
  </view>

  <!-- 纠正点列表 -->
  <view class="card list">
    <view class="list__title">纠正点</view>

    <block wx:if="{{corrects.length}}">
      <view
        wx:for="{{corrects}}"
        wx:key="id"
        class="point {{item.status === 1 ? 'point--done' : ''}}"
        data-id="{{item.id}}"
        data-status="{{item.status}}"
        bindtap="toggle"
      >
        <view class="point__check">{{item.status === 1 ? '✓' : ''}}</view>
        <view class="point__body">
          <view class="point__name">{{item.pointName}}</view>
          <view class="point__note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
        <view class="point__del" data-id="{{item.id}}" catchtap="del">删除</view>
      </view>
    </block>
    <view wx:else class="list__empty">
      还没有纠正点，在下方输入添加第一条吧
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="footer">
    <view class="footer__input-row">
      <input
        class="footer__input"
        placeholder="输入纠正点，如：持拍手肘抬太低"
        value="{{newPoint}}"
        bindinput="onInput"
        confirm-type="done"
        bindconfirm="add"
      />
      <view class="footer__add" bindtap="add">添加</view>
    </view>
    <view class="footer__upload" bindtap="goUpload">上传练习视频</view>
  </view>
</view>