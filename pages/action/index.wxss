/*pages/action/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 自定义返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* 上传卡片 */
.upload {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(63, 104, 255, 0.3);
}

.upload__icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.upload__title {
  font-size: 36rpx;
  font-weight: 700;
}

.upload__tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 16rpx;
}

/* 进度条 */
.upload__bar {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
  margin-top: 36rpx;
}

.upload__bar-in {
  height: 100%;
  background: #ffffff;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.hint {
  text-align: center;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 32rpx;
}

/* 上传图标（CSS绘制箭头） */
.i-upload {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  color: currentColor;
}
.i-upload::before {
  content: '';
  position: absolute;
  left: 8rpx;
  bottom: 4rpx;
  width: 40rpx;
  height: 14rpx;
  border: 6rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}
.i-upload::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 24rpx solid currentColor;
  transform: translateX(-50%);
}

/* 完成对勾 */
.i-done {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  color: currentColor;
}
.i-done::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  width: 28rpx;
  height: 16rpx;
  border-left: 8rpx solid currentColor;
  border-bottom: 8rpx solid currentColor;
  transform: rotate(-45deg);
  box-sizing: border-box;
}