/*pages/action/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* 自定义返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* ========== 可折叠拍摄说明 ========== */
.tips {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
}

.tips__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tips__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.tips__arrow {
  color: #9aa0a6;
  font-size: 24rpx;
  transition: transform 0.2s;
}

.tips__arrow--open {
  transform: rotate(180deg);
}

.tips__body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f7;
}

.tips__line {
  font-size: 26rpx;
  color: #5a6068;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.tips__line:last-child {
  margin-bottom: 0;
}

/* ========== 底部固定上传区 ========== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f6f7fb;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.footer__btn {
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(79, 107, 255, 0.3);
}

.footer__tip {
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  margin-top: 16rpx;
}

.footer__bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e8ecf5;
  overflow: hidden;
  margin: 12rpx 0;
}

.footer__bar-in {
  height: 100%;
  background: linear-gradient(90deg, #4f6bff, #34c0ff);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.footer__done {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  padding: 26rpx 0 0;
}