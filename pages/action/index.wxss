/*pages/action/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* 自定义返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* ========== 可折叠拍摄说明 ========== */
.tips {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
}

.tips__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tips__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.tips__arrow {
  color: #9aa0a6;
  font-size: 24rpx;
  transition: transform 0.2s;
}

.tips__arrow--open {
  transform: rotate(180deg);
}

.tips__body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f7;
}

.tips__line {
  font-size: 26rpx;
  color: #5a6068;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.tips__line:last-child {
  margin-bottom: 0;
}

/* ========== 底部固定上传区 ========== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f6f7fb;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.footer__btn {
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(79, 107, 255, 0.3);
}

.footer__btn--ghost {
  background: #ffffff;
  color: #3d6bff;
  border: 1rpx solid #d7e0ff;
  box-shadow: none;
  margin-top: 20rpx;
}

.footer__tip {
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  margin-top: 16rpx;
}

.footer__bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e8ecf5;
  overflow: hidden;
  margin: 12rpx 0;
}

.footer__bar-in {
  height: 100%;
  background: linear-gradient(90deg, #4f6bff, #34c0ff);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.footer__done {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  padding: 26rpx 0 0;
}

/* ========== 上传完成：视频回看 + 报告 ========== */
.result-video {
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #000000;
}

.result-video__el {
  width: 100%;
  height: 400rpx;
  display: block;
}

.score-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.score-card__action {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.score-card__date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.score-card__score {
  display: flex;
  align-items: baseline;
  margin-top: 24rpx;
}

.score-card__num {
  font-size: 80rpx;
  font-weight: 700;
  color: #3d6bff;
  line-height: 1;
}

.score-card__unit {
  font-size: 26rpx;
  color: #9aa0a6;
  margin-left: 8rpx;
}

.list-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.list-card__title {
  padding: 28rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.point {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.point + .point {
  border-top: 1rpx solid #f0f1f5;
}

.point__status {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.point__status--bad {
  background: #fdecea;
  color: #d9483c;
}

.point__status--ok {
  background: #e6f6ec;
  color: #2ba471;
}

.point__main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.point__name {
  font-size: 28rpx;
  color: #1f2329;
}

.point__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.point__time {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #3d6bff;
}

.report-empty {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.report-empty__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.report-empty__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.refresh {
  text-align: center;
  background: #ffffff;
  color: #3d6bff;
  border: 1rpx solid #d7e0ff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}