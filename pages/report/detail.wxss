/*pages/report/detail.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

/* 返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* 得分卡 */
.score-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.score-card__action {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.score-card__date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.score-card__score {
  display: flex;
  align-items: baseline;
  margin-top: 24rpx;
}

.score-card__num {
  font-size: 80rpx;
  font-weight: 700;
  color: #3d6bff;
  line-height: 1;
}

.score-card__unit {
  font-size: 26rpx;
  color: #9aa0a6;
  margin-left: 8rpx;
}

/* 视频回看 */
.video-card {
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #000000;
}

.video-card__video {
  width: 100%;
  height: 400rpx;
  display: block;
}

/* 纠正点清单 */
.list-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  overflow: hidden;
}

.list-card__title {
  padding: 28rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.point {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.point + .point {
  border-top: 1rpx solid #f0f1f5;
}

.point__status {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.point__status--bad {
  background: #fdecea;
  color: #d9483c;
}

.point__status--ok {
  background: #e6f6ec;
  color: #2ba471;
}

.point__main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.point__name {
  font-size: 28rpx;
  color: #1f2329;
}

.point__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.point__time {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #3d6bff;
}

/* 加载占位 */
.placeholder {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9aa0a6;
}

/* 分析中（动作检测三级模块：等待 AI 分析） */
.analyzing {
  padding: 120rpx 40rpx;
  text-align: center;
}

.analyzing__ring {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  border: 8rpx solid #e6ecff;
  border-top-color: #4f6bff;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.analyzing__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.analyzing__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9aa0a6;
}

/* 分析失败 */
.failed {
  padding: 120rpx 40rpx;
  text-align: center;
}

.failed__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.failed__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9aa0a6;
}

.failed__btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}