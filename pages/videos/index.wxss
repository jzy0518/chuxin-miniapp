/*pages/videos/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

/* 自定义返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* 分段 tab */
.tabs {
  display: flex;
  gap: 8rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #5a6068;
  padding: 16rpx 0;
  border-radius: 14rpx;
}

.tab--on {
  background: #3d6bff;
  color: #ffffff;
  font-weight: 600;
}

/* 视频列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.item__thumb {
  width: 160rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef2ff;
}

.item__thumb--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.item__ph {
  font-size: 22rpx;
  color: #3d6bff;
}

.item__body {
  flex: 1;
  min-width: 0;
}

.item__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.item__tag {
  font-size: 20rpx;
  line-height: 1.6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.item__tag--detect {
  color: #3d6bff;
  background: #eef2ff;
}

.item__tag--battle {
  color: #1f9d68;
  background: #e7f6ee;
}

.item__tag--action {
  color: #8a5b00;
  background: #fdf3dc;
}

.item__time {
  font-size: 22rpx;
  color: #9aa0a6;
}

.item__badge {
  font-size: 22rpx;
  flex-shrink: 0;
}

.item__badge--none {
  color: #9aa0a6;
}

.item__badge--queue {
  color: #f5a623;
}

.item__badge--done {
  color: #1f9d68;
  font-weight: 600;
}

.item__badge--fail {
  color: #d9483c;
}

.empty {
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  padding: 80rpx 0;
}