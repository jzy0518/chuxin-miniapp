/*pages/reports/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

/* 自定义返回头 */
.nav {
  padding: calc(env(safe-area-inset-top) + 16rpx) 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  font-size: 56rpx;
  color: #1f2329;
}

.nav__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.nav__spacer {
  width: 72rpx;
}

/* 分组标题 */
.group {
  margin-bottom: 24rpx;
}

.group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx;
}

.group__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.group__count {
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 报告卡片 */
.report {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}

.report__thumb {
  width: 120rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: #eef1f6;
  flex-shrink: 0;
}

.report__thumb--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #b6bcc4;
}

.report__main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.report__name {
  font-size: 28rpx;
  color: #1f2329;
}

.report__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}

.report__score {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}

.report__score-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d6bff;
}

.report__score-label {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-left: 4rpx;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty__icon {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef1f6;
  font-size: 44rpx;
  color: #b6bcc4;
}

.empty__title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.empty__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9aa0a6;
  text-align: center;
}