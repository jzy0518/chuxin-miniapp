/*pages/mine/index.wxss*/
page {
  height: 100%;
  background: #f6f7fb;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 24rpx) 40rpx calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 未登录 ========== */
.login {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eaf0ff;
  color: #3d6bff;
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login__text {
  font-size: 26rpx;
  color: #9aa0a6;
  margin: 36rpx 0 48rpx;
}

/* 通用按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: linear-gradient(135deg, #4f6bff 0%, #34c0ff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(63, 104, 255, 0.3);
}

/* ========== 已登录 ========== */
.user {
  margin-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #eef0f6;
  border: 4rpx solid #eaf0ff;
}

.user__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  margin-top: 24rpx;
}

.btn--logout {
  margin-top: 96rpx;
  background: #ffffff;
  color: #ff4d4f;
  border: 1rpx solid #ffe3e3;
}